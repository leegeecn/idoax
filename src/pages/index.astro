---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";
import homepageData from "../content/homepage.json";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <!-- ========== 1. HERO：品牌主区 ========== -->
    <section id="hero" class="pt-6 pb-10 text-center sm:pt-10">
      <h1 class="text-5xl font-extrabold tracking-tight sm:text-7xl">
        <span class="text-skin-base">i do</span><span
          class="bg-gradient-to-br from-[#B87A4E] via-[#D69E6B] to-[#E8BE92] bg-clip-text text-transparent"
          >ax</span
        >
      </h1>

      {homepageData.heroSubtitle && (
        <p class="mt-4 text-lg font-medium text-skin-accent sm:text-2xl">
          {homepageData.heroSubtitle}
        </p>
      )}

      {homepageData.heroDescription && (
        <div 
          class="prose mx-auto my-6 max-w-2xl text-skin-base/90" 
          set:html={homepageData.heroDescription}
        />
      )}

      {homepageData.ctaText && homepageData.ctaLink && (
        <div class="mt-8">
          <a
            href={homepageData.ctaLink}
            class="inline-block rounded-full bg-skin-accent px-7 py-3 font-medium text-skin-inverted shadow-lg transition hover:-translate-y-0.5 hover:opacity-95"
          >
            {homepageData.ctaText}
          </a>
        </div>
      )}
    </section>

    <!-- ========== 2. 字母寓意：a & x 双卡片 ========== -->
    <section id="meaning" class="mx-auto my-8 max-w-5xl">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div
          class="group rounded-3xl border border-skin-line bg-skin-card p-6 transition hover:-translate-y-1 hover:border-skin-accent hover:shadow-xl"
        >
          <div
            class="mb-4 flex h-20 w-20 items-center justify-center rounded-2xl bg-gradient-to-br from-[#fefcf9] to-[#f7ede0] shadow-inner"
          >
            <svg viewBox="0 0 60 60" class="h-12 w-12" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="archGrad" x1="10" y1="30" x2="50" y2="54" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#B87A4E" />
                  <stop offset="100%" stop-color="#D69E6B" />
                </linearGradient>
              </defs>
              <rect x="10" y="28" width="9" height="26" rx="4" fill="url(#archGrad)" />
              <rect x="41" y="28" width="9" height="26" rx="4" fill="url(#archGrad)" />
              <path
                d="M14.5 30 C14.5 14, 45.5 14, 45.5 30"
                stroke="url(#archGrad)"
                stroke-width="9"
                stroke-linecap="round"
                fill="none"
              />
              <rect x="25" y="37" width="10" height="5" rx="2.5" fill="#E0B88C" />
            </svg>
          </div>
          <div class="text-2xl font-bold text-skin-base">a · Howard</div>
          <div class="mb-2 text-sm font-medium uppercase tracking-wider text-skin-accent">
            浩然 · 哥哥
          </div>
          <p class="text-sm leading-relaxed text-skin-base/80">
            坚固、平稳的垂直拱门结构，象征哥哥作为家族支柱的稳重与守护。
          </p>
        </div>

        <div
          class="group rounded-3xl border border-skin-line bg-skin-card p-6 transition hover:-translate-y-1 hover:border-skin-accent hover:shadow-xl"
        >
          <div
            class="mb-4 flex h-20 w-20 items-center justify-center rounded-2xl bg-gradient-to-br from-[#fefcf9] to-[#f7ede0] shadow-inner"
          >
            <svg viewBox="0 0 60 60" class="h-12 w-12" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="xGrad1" x1="8" y1="50" x2="30" y2="12" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#C8874E" />
                  <stop offset="100%" stop-color="#E8BE92" />
                </linearGradient>
                <linearGradient id="xGrad2" x1="8" y1="12" x2="52" y2="48" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#D69E6B" />
                  <stop offset="100%" stop-color="#F0D4B0" />
                </linearGradient>
              </defs>
              <path
                d="M8 50 Q18 30, 30 12 Q42 30, 52 50"
                stroke="url(#xGrad1)"
                stroke-width="7"
                stroke-linecap="round"
                fill="none"
              />
              <path
                d="M8 12 Q18 30, 30 48 Q42 30, 52 12"
                stroke="url(#xGrad2)"
                stroke-width="7"
                stroke-linecap="round"
                fill="none"
              />
              <circle cx="30" cy="30" r="3.5" fill="#8A5E3C" />
              <circle cx="30" cy="30" r="1.5" fill="#FFFFFF" opacity="0.85" />
            </svg>
          </div>
          <div class="text-2xl font-bold text-skin-base">x · Sienna</div>
          <div class="mb-2 text-sm font-medium uppercase tracking-wider text-skin-accent">
            欣然 · 妹妹
          </div>
          <p class="text-sm leading-relaxed text-skin-base/80">
            向上延伸、开放流动的双弧线结构，象征妹妹灵动、探索与无限的可能性。
          </p>
        </div>
      </div>
    </section>

    <!-- ========== 3. 服务卡片（CMS 可编辑） ========== -->
    {homepageData.services && homepageData.services.length > 0 && (
      <section id="services" class="mx-auto my-10 max-w-5xl border-t border-skin-line pt-10">
        <h2 class="mb-6 text-center text-2xl font-semibold tracking-wide">
          关于 idoax
        </h2>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
          {homepageData.services.map(service => (
            <div class="rounded-2xl border border-skin-line bg-skin-card p-5 transition hover:border-skin-accent hover:shadow-lg">
              <h3 class="mb-2 text-lg font-bold text-skin-base">{service.title}</h3>
              <p class="mb-3 text-sm leading-relaxed text-skin-base/80">{service.description}</p>
              {service.link && (
                <a href={service.link} class="text-xs font-medium text-skin-accent underline">
                  了解更多 →
                </a>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- ========== 4. 三条品牌标语（固定内容，不走 CMS） ========== -->
    <section id="slogans" class="mx-auto my-12 max-w-4xl">
      <div class="space-y-4">
        <div class="rounded-2xl border border-skin-line bg-gradient-to-r from-[#fefcf9] to-[#faf4ec] p-6 text-center">
          <div class="text-sm font-semibold uppercase tracking-widest text-skin-accent">
            Childhood & Family
          </div>
          <div class="mt-2 text-xl font-bold text-skin-base">
            I do love, I do support, I do believe.
          </div>
          <div class="mt-1 text-sm text-skin-base/70">
            爱其所爱，予其所向，信其无限。
          </div>
        </div>

        <div class="rounded-2xl border border-skin-line bg-gradient-to-r from-[#fefcf9] to-[#f6f1ea] p-6 text-center">
          <div class="text-sm font-semibold uppercase tracking-widest text-skin-accent">
            Professional / Future
          </div>
          <div class="mt-2 text-xl font-bold text-skin-base">
            Where Passion Meets Infinite Possibilities.
          </div>
          <div class="mt-1 text-sm text-skin-base/70">
            激情所至，无限可能。
          </div>
        </div>
      </div>
    </section>

    <!-- ========== 5. 成长日志（Featured + Recent） ========== -->
    {featuredPosts.length > 0 && (
      <section
        id="featured"
        class:list={[
          "pt-8 pb-6",
          { "border-border border-b": recentPosts.length > 0 },
        ]}
      >
        <h2 class="text-2xl font-semibold tracking-wide">
          {t.home.featured}
        </h2>
        <ul>
          {featuredPosts.map(data => (
            <Card variant="h3" {...data} />
          ))}
        </ul>
      </section>
    )}

    {recentPosts.length > 0 && (
      <section id="recent-posts" class="pt-12 pb-6">
        <h2 class="text-2xl font-semibold tracking-wide">
          {t.home.recentPosts}
        </h2>
        <ul>
          {recentPosts.slice(0, postsConfig.perIndex).map(data => (
            <Card variant="h3" {...data} />
          ))}
        </ul>
      </section>
    )}

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>

    <!-- ========== 6. 自建 3D 全球访客足迹地球挂件 ========== -->
    <section class="mt-12 mb-10 my-10 flex flex-col items-center justify-center">
      <h2 class="text-2xl font-bold mb-4 text-center">🌍 全球访客足迹</h2>
      
      <!-- 地球渲染容器 -->
      <div 
        id="visitor-globe-container" 
        class="w-[340px] h-[340px] md:w-[420px] md:h-[420px] rounded-full overflow-hidden shadow-2xl bg-slate-900 border border-slate-800"
      ></div>
    </section>

    <!-- 1. 引入 3D 地球渲染库 -->
    <script is:inline src="https://unpkg.com/globe.gl"></script>

    <!-- 2. 地球初始化与数据联动脚本 -->
    <script is:inline>
      function init3DGlobe() {
        const container = document.getElementById('visitor-globe-container');
        if (!container || container.getAttribute('data-globe-inited')) return;
        container.setAttribute('data-globe-inited', 'true');

        const width = container.clientWidth || 340;

        // 初始化 3D 地球实例
        const world = Globe()
          (container)
          .globeImageUrl('https://img.idoax.com/idoax.com/earth-night.jpg') // 夜景图
          .backgroundImageUrl('https://img.idoax.com/idoax.com/night-sky.png') // 星空背景
          .width(width)
          .height(width)
          .pointOfView({ lat: 25, lng: 110, altitude: 2.1 }) // 视角初始对准中国/东亚区
          .pointAltitude('size')
          .pointColor(() => '#ffaa00') // 暖金色发光打点
          .pointRadius(0.6)
          .pointsMerge(true);

        // 开启自动自转与控制设置
        world.controls().autoRotate = true;
        world.controls().autoRotateSpeed = 0.8;
        world.controls().enableZoom = false; // 禁用滚轮缩放

        // 从你的专属二级域名请求打点数据
        fetch('https://globe.idoax.com/api/globe-data')
          .then(res => res.json())
          .then(data => {
            if (Array.isArray(data) && data.length > 0) {
              world.pointsData(data);
            } else {
              // 无数据时的保底节点
              world.pointsData([
                { lat: 39.9042, lng: 116.4074, size: 0.15 }, // 北京
                { lat: 31.2304, lng: 121.4737, size: 0.12 }, // 上海
                { lat: 37.7749, lng: -122.4194, size: 0.12 } // 旧金山
              ]);
            }
          })
          .catch(() => {
            world.pointsData([{ lat: 39.9042, lng: 116.4074, size: 0.1 }]);
          });
      }

      // 兼容标准加载与 Astro View Transitions 页面切换
      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        init3DGlobe();
      } else {
        document.addEventListener('DOMContentLoaded', init3DGlobe);
      }
      document.addEventListener('astro:page-load', init3DGlobe);
    </script>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>

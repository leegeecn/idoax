---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const items = await getCollection("gallery");
const sortedItems = items.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const childMap: Record<string, string> = {
  haoran: "👦 浩然",
  xinran: "👧 欣然",
  family: "👨‍👩‍👧‍👦 欢聚时光",
};
---

<Layout title="孩子们的影像地带 - IDOAX">
  <Header />

  <main id="main-content" class="app-layout my-1">
    <!-- ========== 1. HERO 头部区域（对齐首页风格） ========== -->
    <section id="hero" class="pt-6 pb-8 text-center sm:pt-10">
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-6xl">
        <span class="text-skin-base">孩子们的</span><span
          class="bg-gradient-to-br from-[#B87A4E] via-[#D69E6B] to-[#E8BE92] bg-clip-text text-transparent"
          >影像地带</span
        >
      </h1>
      <p class="mt-4 text-base font-medium text-skin-accent sm:text-xl">
        记录浩然与欣然的成长足迹、童真瞬间与珍贵视频
      </p>
    </section>

    <!-- ========== 2. 媒体画廊网格（对齐首页卡片设计） ========== -->
    <section id="gallery-grid" class="mx-auto my-6 max-w-6xl">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        {
          sortedItems.map(item => {
            const { title, type, mediaUrl, posterUrl, child, location, description } = item.data;
            return (
              <div
                class="group media-card relative overflow-hidden rounded-3xl border border-skin-line bg-skin-card shadow-sm transition hover:-translate-y-1 hover:border-skin-accent hover:shadow-xl cursor-pointer"
                data-type={type}
                data-url={mediaUrl}
                data-title={title}
                data-child={childMap[child] || ""}
                data-location={location || ""}
                data-desc={description || ""}
              >
                {/* 媒体展示层 */}
                {type === "video" ? (
                  <div class="relative h-64 w-full bg-slate-900 sm:h-72">
                    <video
                      src={mediaUrl}
                      poster={posterUrl || ""}
                      preload="metadata"
                      muted
                      playsinline
                      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 flex items-center justify-center bg-black/30 transition-colors group-hover:bg-black/10">
                      <div class="flex h-12 w-12 items-center justify-center rounded-full bg-white/80 text-black shadow-lg backdrop-blur transition-transform group-hover:scale-110">
                        ▶
                      </div>
                    </div>
                  </div>
                ) : (
                  <div class="relative h-64 w-full bg-slate-900 sm:h-72">
                    <img
                      src={mediaUrl}
                      alt={title}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                  </div>
                )}

                {/* 角色角标 */}
                <div class="absolute top-3 left-3 z-10 rounded-full bg-black/60 px-3 py-1 text-xs font-medium text-white backdrop-blur-md">
                  {childMap[child]}
                </div>

                {/* 悬停渐变遮罩与文字 */}
                <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/85 via-black/40 to-transparent p-5 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                  <h3 class="font-bold text-white text-base transform translate-y-2 transition-transform duration-300 group-hover:translate-y-0">
                    {title}
                  </h3>

                  {description && (
                    <p class="mt-1.5 text-xs text-gray-200 line-clamp-2 leading-relaxed transform translate-y-3 transition-transform duration-300 delay-75">
                      {description}
                    </p>
                  )}

                  {location && (
                    <p class="mt-2 text-[11px] text-amber-300 transform translate-y-3 transition-transform duration-300 delay-100">
                      📍 {location}
                    </p>
                  )}
                </div>
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- ========== 3. 全屏灯箱 (Lightbox Modal) ========== -->
    <div
      id="lightbox"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4 backdrop-blur-md"
    >
      <button
        id="lightbox-close"
        class="absolute top-5 right-6 z-50 text-3xl font-light text-white transition hover:text-skin-accent"
        aria-label="关闭预览"
      >
        &times;
      </button>

      <div
        class="flex max-h-[90vh] w-full max-w-5xl flex-col overflow-hidden rounded-3xl border border-skin-line bg-skin-card shadow-2xl md:flex-row"
      >
        {/* 媒体展示区 */}
        <div
          id="lightbox-media-container"
          class="flex h-[45vh] w-full items-center justify-center bg-black md:h-[75vh] md:w-2/3"
        >
          {/* JS 动态渲染 img 或 video */}
        </div>

        {/* 侧边信息区 */}
        <div
          class="flex h-auto w-full flex-col justify-between p-6 text-skin-base md:h-[75vh] md:w-1/3"
        >
          <div>
            <div
              id="lightbox-child"
              class="mb-2 text-xs font-semibold uppercase tracking-wider text-skin-accent"
            >
            </div>
            <h2 id="lightbox-title" class="mb-3 text-xl font-bold"></h2>
            <p
              id="lightbox-desc"
              class="text-sm leading-relaxed text-skin-base/80 whitespace-pre-line"
            >
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-skin-line">
            <p id="lightbox-location" class="text-xs text-skin-base/60"></p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<!-- ========== 4. 交互逻辑脚本（兼容 Astro View Transitions） ========== -->
<script>
  function initGallery() {
    const lightbox = document.getElementById("lightbox");
    const container = document.getElementById("lightbox-media-container");
    const lbTitle = document.getElementById("lightbox-title");
    const lbChild = document.getElementById("lightbox-child");
    const lbDesc = document.getElementById("lightbox-desc");
    const lbLocation = document.getElementById("lightbox-location");
    const closeBtn = document.getElementById("lightbox-close");

    if (!lightbox || !container) return;

    document.querySelectorAll(".media-card").forEach((card) => {
      card.addEventListener("click", () => {
        const type = card.getAttribute("data-type");
        const url = card.getAttribute("data-url") || "";
        const title = card.getAttribute("data-title") || "";
        const child = card.getAttribute("data-child") || "";
        const location = card.getAttribute("data-location") || "";
        const desc = card.getAttribute("data-desc") || "";

        container.innerHTML = "";
        if (type === "video") {
          const video = document.createElement("video");
          video.src = url;
          video.controls = true;
          video.autoplay = true;
          video.className = "max-h-full max-w-full rounded-xl";
          container.appendChild(video);
        } else {
          const img = document.createElement("img");
          img.src = url;
          img.alt = title;
          img.className = "max-h-full max-w-full object-contain rounded-xl";
          container.appendChild(img);
        }

        if (lbTitle) lbTitle.textContent = title;
        if (lbChild) lbChild.textContent = child;
        if (lbDesc) lbDesc.textContent = desc;
        if (lbLocation) lbLocation.textContent = location ? `📍 ${location}` : "";

        lightbox.classList.remove("hidden");
        lightbox.classList.add("flex");
      });
    });

    const close = () => {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      container.innerHTML = ""; // 清空元素停止视频播放
    };

    closeBtn?.addEventListener("click", close);
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
  }

  // 保证静态渲染与无刷新路由跳转时逻辑均正常绑定
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initGallery();
  } else {
    document.addEventListener("DOMContentLoaded", initGallery);
  }
  document.addEventListener("astro:page-load", initGallery);
</script>

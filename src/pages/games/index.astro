---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

// 整理后的开源小游戏列表
const games = [
  {
    title: "俄罗斯方块 (React Tetris)",
    url: "https://leegeecn.github.io/react-tetris/",
    author: "chvin",
    desc: "掌机时代的童年回忆，React 完美的掌机按键模拟。"
  },
  {
    title: "2048 益智数字",
    url: "https://leegeecn.github.io/2048/",
    author: "gabrielecirulli",
    desc: "风靡全球的数字滑动合并益智游戏，简单却极其虐心。"
  },
  {
    title: "滑动数字拼图 (Sliding Puzzle)",
    url: "https://www.sandeepnambiar.com/sliding_puzzle/",
    author: "gamedolphin",
    desc: "类似华容道与经典拼图的玩法，考验逻辑与数理推演。"
  }
];
---

<Layout title="益智游戏厅 - IDOAX">
  <Header />

  <main id="main-content" class="app-layout my-1">
    <!-- ========== 1. HERO 头部区域（对齐首页风格） ========== -->
    <section id="hero" class="pt-6 pb-8 text-center sm:pt-10">
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-6xl">
        <span class="text-skin-base">开源益智</span><span
          class="bg-gradient-to-br from-[#B87A4E] via-[#D69E6B] to-[#E8BE92] bg-clip-text text-transparent"
          >游戏厅</span
        >
      </h1>
      <p class="mt-4 text-base font-medium text-skin-accent sm:text-xl">
        精选 GitHub 上有趣的开源小游戏，致敬经典，随时随地放松一下。
      </p>
    </section>

    <!-- ========== 2. 游戏卡片网格（对齐首页卡片设计） ========== -->
    <section id="games-grid" class="mx-auto my-8 max-w-6xl">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {games.map((game) => (
          <div class="group flex flex-col justify-between rounded-3xl border border-skin-line bg-skin-card p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-skin-accent hover:shadow-xl">
            <div>
              <div class="mb-2 flex items-center justify-between">
                <h3 class="text-xl font-bold text-skin-base group-hover:text-skin-accent transition-colors">
                  {game.title}
                </h3>
              </div>
              <p class="mb-4 text-xs font-medium tracking-wider text-skin-accent uppercase">
                作者: @{game.author}
              </p>
              <p class="mb-6 text-sm leading-relaxed text-skin-base/80">
                {game.desc}
              </p>
            </div>
            
            <a
              href={game.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 w-full py-3 px-5 rounded-full bg-skin-accent text-skin-inverted font-medium shadow-md transition duration-300 hover:-translate-y-0.5 hover:opacity-95"
            >
              开始游玩 🎮
            </a>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
